{
  "title": "YouTube Transcript Extractor",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "videoUrl": {
      "title": "YouTube video URL",
      "type": "string",
      "description": "Supports watch?v=, youtu.be/, shorts/",
      "editor": "textfield"
    },
    "preferredLanguage": {
      "title": "Preferred transcript languages (ordered)",
      "type": "array",
      "description": "Example: [\"en\", \"en-US\"]",
      "editor": "stringList"
    },
    "languagePreference": {
      "title": "Preferred transcript languages (legacy)",
      "type": "array",
      "description": "Legacy alias for preferredLanguage",
      "editor": "stringList"
    },
    "removeBrackets": {
      "title": "Remove bracketed non-speech markers",
      "type": "boolean",
      "default": true
    },
    "joinWith": {
      "title": "Join transcript segments with",
      "type": "string",
      "enum": ["space", "newline"],
      "default": "space"
    },
    "outputMode": {
      "title": "Output mode",
      "type": "string",
      "enum": ["text_only", "text_and_segments"],
      "default": "text_only"
    },
    "proxyMode": {
      "title": "Proxy mode",
      "type": "string",
      "enum": ["off", "auto", "datacenter", "residential"],
      "default": "auto"
    },
    "debug": {
      "title": "Debug logging",
      "type": "boolean",
      "default": false
    },
    "saveVttToKV": {
      "title": "Save VTT to Key-Value Store",
      "type": "boolean",
      "default": false
    },
    "maxRetries": {
      "title": "Max retries",
      "type": "integer",
      "default": 2,
      "minimum": 0,
      "maximum": 10
    },
    "timeoutMs": {
      "title": "Total timeout (ms)",
      "type": "integer",
      "default": 180000,
      "minimum": 1000,
      "maximum": 300000000
    },
    "timeoutSecs": {
      "title": "Total timeout (seconds, optional)",
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    }
  },
  "required": ["videoUrl"]
}
